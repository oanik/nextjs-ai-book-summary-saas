# ─── MySQL (Docker Compose service) ─────────────────────────────────────────
# These variables configure the MySQL container itself.
# The DATABASE_URL host MUST be "mysql" — the Docker Compose service name.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=bookwise
MYSQL_USER=bookwise
MYSQL_PASSWORD=change_me_password

# ─── Application ─────────────────────────────────────────────────────────────
# DATABASE_URL uses "mysql" as the host so the app can reach the container.
DATABASE_URL=mysql://bookwise:change_me_password@mysql:3306/bookwise

NEXT_PUBLIC_APP_NAME=BookWise
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BOOK_SUMMARY_MODEL=gpt-4o-mini
